# --- Database (Vercel Postgres injects POSTGRES_URL automatically when linked) ---
POSTGRES_URL="postgres://user:password@host/dbname?sslmode=require"

# --- Auth.js: generate with `openssl rand -base64 32` ---
AUTH_SECRET="replace-with-a-long-random-string"

# --- Tindie Project Import: GitHub App connection ---
# Create a GitHub App with read-only Repository contents + Metadata permissions.
# Set the GitHub App Setup URL to:
#   https://YOUR_DOMAIN/api/project-import/connections/github/callback
# The app can be installed on all repositories or only repositories selected by the seller.
# GITHUB_APP_ID="123456"
# GITHUB_APP_SLUG="tindie-project-import"
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# Optional dedicated cookie-signing secret. AUTH_SECRET is used as fallback.
# CONNECTION_SIGNING_SECRET="replace-with-a-random-string"

# Optional fallback token for server-side public GitHub API rate limits.
# Do not use this as the normal seller connection mechanism.
# GITHUB_TOKEN="github_pat_..."

# Optional AI refinement of generated listings.
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-5"

# --- Protects the daily cron endpoint (any random string) ---
CRON_SECRET="replace-with-a-random-string"

# --- OPTIONAL: rate limiting for public write endpoints (submit/subscribe/
#     comment/track/login). Create an Upstash Redis via the Vercel Marketplace
#     (Storage tab) and it injects these automatically. If unset, rate limiting
#     is disabled (fails open) and the app still runs. Legacy Vercel KV names
#     (KV_REST_API_URL / KV_REST_API_TOKEN) are also accepted. ---
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxx"

# --- Seed admin account (used by `npm run db:seed`) ---
SEED_ADMIN_EMAIL="admin@tindie.test"
SEED_ADMIN_PASSWORD="changeme123"

# --- OPTIONAL: existing discovery-pipeline summarizer ---
# ANTHROPIC_API_KEY="sk-ant-..."
# Daily open-hardware picks (Open hardware tab, /api/cron/design-picks). Uses ANTHROPIC_API_KEY;
# without it nothing is picked. Optional overrides:
# DESIGN_PICKS_MODEL="claude-opus-5-5"   # model that reviews and summarises each design
# DESIGN_PICKS_PER_DAY=3                 # designs published per day (1-6)
# DESIGN_PICKS_MAX_JUDGED=10             # candidates sent to Claude per day (1-20)


# --- Tindie parts database (ezplm_partdata Partner API) — Components / Open hardware / graph ---
# Server-only. NEVER prefix with NEXT_PUBLIC_. Create the key in partdata admin → 「对外接口」 with
# scopes parts:read, designs:read, kg:read. The secret is shown once; if lost or leaked, disable it
# there and create a new one.
PARTDATA_API_BASE=https://<partdata-host>
PARTDATA_API_KEY=pk_xxxxxxxxxxxxxxxx
PARTDATA_API_SECRET=replace-with-the-secret
# Optional: salt for the anonymous per-visitor hash sent as X-End-User (defaults to the secret).
# PARTDATA_VISITOR_SALT=

# --- Optional distributor fallback for parts not in the database / BOM pricing ---
# DIGIKEY_CLIENT_ID=
# DIGIKEY_CLIENT_SECRET=
# DIGIKEY_ENV=production
# MOUSER_API_KEY=

# --- Optional machine translation (Azure Translator v3, not an LLM) for Chinese text not in the glossary ---
# AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=

# --- GitHub (Open hardware designs are fetched from GitHub at their pinned commit) ---
# Strongly recommended in production: a fine-grained token with public read-only access raises the
# GitHub API quota from 60 to 5,000 requests/hour. Never sent to the browser.
# MAKER_GITHUB_TOKEN=
# Signs GitHub import selections between the scan and import requests (random per process if unset;
# set it when running more than one server instance).
# MAKER_IMPORT_SECRET=

# --- New Discover tabs (Components / Open hardware / PCB planner): preview until go-live ---
# Unset: only signed-in admins / editors, or a browser that opened /tools/preview?key=<MAKER_PREVIEW_KEY>,
# see the new tabs; everyone else sees the original Discover page. Set to 1 to open them to everyone.
# MAKER_TOOLS_PUBLIC=1
# At least 16 random characters (e.g. `openssl rand -hex 16`).
# MAKER_PREVIEW_KEY=
