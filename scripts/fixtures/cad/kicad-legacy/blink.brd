# Synthetic fixture for scripts/format-coverage-checks.ts (KiCad 2011 legacy board, 1/10000 inch)

$GENERAL
encoding utf-8
LayerCount 2
Ly 1FFF8001
Di 10000 10000 30000 20000
Nmodule 2
Nnets 3
BoardThickness 630
$EndGENERAL

$SETUP
InternalUnit 0.000100 INCH
Layers 2
Layer[0] Back signal
Layer[15] Front signal
ViaSize 350
ViaDrill 250
$EndSETUP

$EQUIPOT
Na 0 ""
St ~
$EndEQUIPOT
$EQUIPOT
Na 1 "/LED"
St ~
$EndEQUIPOT
$EQUIPOT
Na 2 "GND"
St ~
$EndEQUIPOT
$MODULE SM0805
Po 15000 15000 900 15 4F00AA01 4F00AA01 ~~
Li SM0805
Sc 4F00AA01
AR /4F00AA01
Op 0 0 0
At SMD
T0 0 -800 300 250 900 50 N V 21 N "R1"
T1 0 800 300 250 900 50 N I 21 N "330"
DS -800 -400 800 -400 50 21
DC 0 0 100 0 50 21
DA 0 0 400 0 900 50 21
$PAD
Sh "1" R 500 600 0 0 900
Dr 0 0 0
At SMD N 00888000
Ne 1 "/LED"
Po -400 0
$EndPAD
$PAD
Sh "2" R 500 600 0 0 900
Dr 0 0 0
At SMD N 00888000
Ne 2 "GND"
Po 400 0
$EndPAD
$SHAPE3D
Na "smd/resistors/r_0805.wrl"
Sc 1.000000 1.000000 1.000000
Of 0.000000 0.000000 0.000000
Ro 0.000000 0.000000 0.000000
$EndSHAPE3D
$EndMODULE  SM0805
$MODULE LED-3MM
Po 25000 15000 0 0 4F00AA02 4F00AA02 ~~
Li LED-3MM
Sc 4F00AA02
AR /4F00AA02
Op 0 0 0
T0 0 -1200 400 400 0 60 N V 20 N "D1"
T1 0 1200 400 400 0 60 N I 20 N "RED"
DS -600 -600 600 -600 60 20
$PAD
Sh "1" R 600 600 0 0 0
Dr 320 0 0
At STD N 00E0FFFF
Ne 1 "/LED"
Po -500 0
$EndPAD
$PAD
Sh "2" O 600 900 0 0 0
Dr 320 0 0 O 320 500
At STD N 00E0FFFF
Ne 2 "GND"
Po 500 0
$EndPAD
$EndMODULE  LED-3MM
$TEXTPCB
Te "BLINK"
Po 20000 18500 600 800 120 0
De 21 1 0 Normal
$EndTEXTPCB
$DRAWSEGMENT
Po 0 10000 10000 30000 10000 150
De 28 0 900 0 0
$EndDRAWSEGMENT
$DRAWSEGMENT
Po 0 30000 10000 30000 20000 150
De 28 0 900 0 0
$EndDRAWSEGMENT
$DRAWSEGMENT
Po 0 30000 20000 10000 20000 150
De 28 0 900 0 0
$EndDRAWSEGMENT
$DRAWSEGMENT
Po 0 10000 20000 10000 10000 150
De 28 0 900 0 0
$EndDRAWSEGMENT
$TRACK
Po 0 15000 14600 20000 14600 100 -1
De 15 0 1 0 0
Po 3 20000 14600 20000 14600 350 -1
De 15 1 1 0 0
Po 0 20000 14600 24500 15000 100 -1
De 0 0 1 0 0
$EndTRACK
$ZONE
$EndZONE
$CZONE_OUTLINE
ZInfo 4F00AA03 2 "GND"
ZLayer 0
