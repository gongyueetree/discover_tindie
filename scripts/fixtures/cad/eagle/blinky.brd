<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE eagle SYSTEM "eagle.dtd">
<!-- Authored for EELIB.IO's tests (2026-10-27): the board of blinky.sch — a part rotated, one smashed, one mirrored onto the bottom. -->
<eagle version="9.6.2">
<drawing>
<settings>
<setting alwaysvectorfont="no"/>
</settings>
<grid distance="0.05" unitdist="inch" unit="inch" style="lines" multiple="1" display="no"/>
<layers>
<layer number="1" name="Top" color="4" fill="1" visible="yes" active="yes"/>
<layer number="16" name="Bottom" color="1" fill="1" visible="yes" active="yes"/>
<layer number="20" name="Dimension" color="24" fill="1" visible="yes" active="yes"/>
<layer number="21" name="tPlace" color="7" fill="1" visible="yes" active="yes"/>
<layer number="25" name="tNames" color="7" fill="1" visible="yes" active="yes"/>
<layer number="51" name="tDocu" color="7" fill="1" visible="yes" active="yes"/>
</layers>
<board>
<plain>
<wire x1="0" y1="0" x2="40" y2="0" width="0" layer="20"/>
<wire x1="40" y1="0" x2="40" y2="25" width="0" layer="20"/>
<wire x1="40" y1="25" x2="35" y2="30" width="0" layer="20" curve="90"/>
<wire x1="35" y1="30" x2="0" y2="30" width="0" layer="20"/>
<wire x1="0" y1="30" x2="0" y2="0" width="0" layer="20"/>
<hole x="3" y="3" drill="3.2"/>
<text x="5" y="26" size="1.5" layer="21" ratio="12">BLINKY v1</text>
<wire x1="5" y1="25" x2="20" y2="25" width="0.2" layer="21"/>
</plain>
<libraries>
<library name="demo">
<packages>
<package name="R0603">
<smd name="1" x="-0.8" y="0" dx="0.9" dy="1" layer="1"/>
<smd name="2" x="0.8" y="0" dx="0.9" dy="1" layer="1"/>
<wire x1="-1.4" y1="0.7" x2="1.4" y2="0.7" width="0.127" layer="51"/>
<wire x1="1.4" y1="0.7" x2="1.4" y2="-0.7" width="0.127" layer="51"/>
<wire x1="1.4" y1="-0.7" x2="-1.4" y2="-0.7" width="0.127" layer="51"/>
<wire x1="-1.4" y1="-0.7" x2="-1.4" y2="0.7" width="0.127" layer="51"/>
<text x="0" y="1.2" size="0.8" layer="25" align="bottom-center">&gt;NAME</text>
<text x="0" y="-1.2" size="0.8" layer="27" align="top-center">&gt;VALUE</text>
</package>
<package name="LED3MM">
<pad name="A" x="-1.27" y="0" drill="0.8" shape="square"/>
<pad name="K" x="1.27" y="0" drill="0.8"/>
<circle x="0" y="0" radius="1.6" width="0.2" layer="21"/>
<circle x="0" y="0" radius="1.5" width="0.1" layer="51"/>
<text x="-2" y="2" size="1" layer="25">&gt;NAME</text>
</package>
<package name="SOT23">
<smd name="1" x="-0.95" y="-1.1" dx="0.6" dy="1" layer="1"/>
<smd name="2" x="0.95" y="-1.1" dx="0.6" dy="1" layer="1"/>
<smd name="3" x="0" y="1.1" dx="0.6" dy="1" layer="1"/>
<wire x1="-1.45" y1="0.65" x2="1.45" y2="0.65" width="0.127" layer="51"/>
<wire x1="1.45" y1="0.65" x2="1.45" y2="-0.65" width="0.127" layer="51"/>
<wire x1="1.45" y1="-0.65" x2="-1.45" y2="-0.65" width="0.127" layer="51"/>
<wire x1="-1.45" y1="-0.65" x2="-1.45" y2="0.65" width="0.127" layer="51"/>
<text x="-1.5" y="2" size="0.8" layer="25">&gt;NAME</text>
</package>
</packages>
</library>
</libraries>
<attributes/>
<variantdefs/>
<classes>
<class number="0" name="default" width="0" drill="0"/>
</classes>
<designrules name="default">
<param name="layerSetup" value="(1*16)"/>
<param name="mtCopper" value="0.035mm 0.035mm"/>
<param name="mtIsolate" value="1.5mm"/>
<param name="rvPadTop" value="0.25"/>
<param name="rlMinPadTop" value="10mil"/>
<param name="rlMaxPadTop" value="20mil"/>
<param name="rvViaOuter" value="0.25"/>
<param name="rlMinViaOuter" value="8mil"/>
<param name="rlMaxViaOuter" value="20mil"/>
</designrules>
<autorouter/>
<elements>
<element name="R1" library="demo" package="R0603" value="10k" x="10" y="10">
<attribute name="MPN" value="RC0603FR-0710KL"/>
<attribute name="MANUFACTURER" value="Yageo"/>
</element>
<element name="R2" library="demo" package="R0603" value="330" x="20" y="12" rot="R90"/>
<element name="LED1" library="demo" package="LED3MM" value="RED" x="30" y="15" rot="MR0"/>
<element name="Q1" library="demo" package="SOT23" value="MMBT3904" x="15" y="20" rot="R180" smashed="yes">
<attribute name="MPN" value="MMBT3904LT1G"/>
<attribute name="MANUFACTURER" value="onsemi"/>
<attribute name="NAME" x="13" y="23" size="1" layer="25"/>
</element>
</elements>
<signals>
<signal name="VCC">
<contactref element="R2" pad="2"/>
<wire x1="20" y1="12.8" x2="20" y2="28" width="0.4" layer="1"/>
</signal>
<signal name="N$1">
<contactref element="R2" pad="1"/>
<contactref element="LED1" pad="A"/>
<wire x1="20" y1="11.2" x2="31.27" y2="15" width="0.25" layer="16" curve="30"/>
</signal>
<signal name="LED_K">
<contactref element="LED1" pad="K"/>
<contactref element="Q1" pad="3"/>
<wire x1="15" y1="18.9" x2="22" y2="18.9" width="0.25" layer="1"/>
<via x="22" y="18.9" extent="1-16" drill="0.35"/>
<wire x1="22" y1="18.9" x2="28.73" y2="15" width="0.25" layer="16"/>
</signal>
<signal name="BASE">
<contactref element="R1" pad="2"/>
<contactref element="Q1" pad="1"/>
<wire x1="10.8" y1="10" x2="15.95" y2="15" width="0.25" layer="1"/>
<wire x1="15.95" y1="15" x2="15.95" y2="21.1" width="0.25" layer="1"/>
<wire x1="10.8" y1="10" x2="15.95" y2="21.1" width="0" layer="19"/>
</signal>
<signal name="GND">
<contactref element="Q1" pad="2"/>
<wire x1="14.05" y1="21.1" x2="14.05" y2="24" width="0.25" layer="1"/>
<via x="14.05" y="24" extent="1-16" drill="0.35" diameter="0.7"/>
<polygon width="0.2" layer="16" isolate="0.3">
<vertex x="1" y="1"/>
<vertex x="39" y="1"/>
<vertex x="39" y="29"/>
<vertex x="1" y="29"/>
</polygon>
</signal>
<signal name="DRIVE">
<contactref element="R1" pad="1"/>
</signal>
</signals>
</board>
</drawing>
</eagle>
