@@ -275,16 +275,41 @@ def ezplm_symbol_preview(name: str, fetch: bool = True) -> dict | None:
             except Exception:  # noqa
                 pass
         if f.exists():
-            texts.insert(0, f.read_text("utf-8", "ignore"))
+            texts.append(f.read_text("utf-8", "ignore"))      # 自身在前、根符号在后（读第一个符号的工具拿到的是这个物料的）
