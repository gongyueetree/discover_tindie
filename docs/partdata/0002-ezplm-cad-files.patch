+def test_ezplm_library_files(client, tmp_path, monkeypatch):
+    """Tindie: a part's ezPLM symbol / footprint / 3D files, signed; only what ezPLM's own library has."""
+    from ezplm_pilot import previews
+    from ezplm_pilot.staging import EzFootprint, EzSymbol
+    from ezplm_pilot.web import _new_session
+    monkeypatch.setattr(previews, "EZ_CACHE", tmp_path)
+    monkeypatch.setattr(previews, "_ez_api", lambda: (_ for _ in ()).throw(RuntimeError("offline")))
+    db = _new_session()
+    _seed(db)
+    db.query(StagedPart).filter(StagedPart.id == "pa-2").update({"orig_symbol": "ezlib:PUBSYM1", "orig_footprint": "PUBFP_QFN-8"})
+    db.merge(EzSymbol(id="ez-s1", name="PUBSYM1", category="Interface", root_id="ez-root", root_name="PUBROOT"))
+    db.merge(EzFootprint(id="ez-f1", name="PUBFP_QFN-8", category="Package_DFN_QFN", has_3d=True))
+    db.commit()
+    (tmp_path / "sym").mkdir()
+    (tmp_path / "sym" / "ez-s1.kicad_sym").write_text('(kicad_symbol_lib (version 20211014)\n  (symbol "PUBSYM1" (extends "PUBROOT"))\n)\n')
+    (tmp_path / "sym" / "ez-root.kicad_sym").write_text('(kicad_symbol_lib (version 20211014)\n  (symbol "PUBROOT" (pin input line (at 0 0 0) (length 2.54)))\n)\n')
+    (tmp_path / "fp" / "ez-f1").mkdir(parents=True)
+    (tmp_path / "fp" / "ez-f1" / "meta.json").write_text("{}")
+    (tmp_path / "fp" / "ez-f1" / "fp.kicad_mod").write_text('(footprint "PUBFP_QFN-8" (pad "1" smd rect (at 0 0) (size 1 1) (layers "F.Cu")))\n')
+    (tmp_path / "fp" / "ez-f1" / "model.step").write_bytes(b"ISO-10303-21;\nEND-ISO-10303-21;\n")
+    pub_api.METER.reset()
+    kid, sec = pub_api.new_key(db, "tindie", list(pub_api.SCOPES))
+    pid = next(x["id"] for x in call(client, kid, sec, "GET", "/api/pub/v1/parts/search", {"q": "PUBX485EN"}).json()["data"]["items"]
+               if x["manufacturer"] == "Acme")
+    detail = call(client, kid, sec, "GET", f"/api/pub/v1/parts/{pid}").json()["data"]
+    assert detail["ezplm_library"] == {"symbol": True, "footprint": True, "model": True}
+    sym = call(client, kid, sec, "GET", f"/api/pub/v1/parts/{pid}/cad/symbol")
+    assert sym.status_code == 200 and b'(symbol "PUBROOT"' in sym.content                              # 带根符号
+    assert sym.content.index(b'(symbol "PUBSYM1"') < sym.content.index(b'(symbol "PUBROOT"')           # 物料自己的在前
+    fp = call(client, kid, sec, "GET", f"/api/pub/v1/parts/{pid}/cad/footprint")
+    assert fp.status_code == 200 and fp.content.startswith(b'(footprint "PUBFP_QFN-8"') and 'filename="PUBFP_QFN-8.kicad_mod"' in fp.headers["content-disposition"]
+    step = call(client, kid, sec, "GET", f"/api/pub/v1/parts/{pid}/cad/model")
+    assert step.status_code == 200 and step.content.startswith(b"ISO-10303-21") and step.headers["content-type"].startswith("model/step")
+    assert call(client, kid, sec, "GET", f"/api/pub/v1/parts/{pid}/cad/netlist").status_code == 404
+    assert client.get(f"/api/pub/v1/parts/{pid}/cad/footprint").status_code == 401                  # 要签名
+    # 封装有未决冲突（pa-1）或不在 ezPLM 库里：不给
+    pid1 = next(x["id"] for x in call(client, kid, sec, "GET", "/api/pub/v1/parts/search", {"q": "PUBX485ECSA"}).json()["data"]["items"])
+    assert call(client, kid, sec, "GET", f"/api/pub/v1/parts/{pid1}/cad/footprint").status_code == 404
+    db.query(EzSymbol).filter(EzSymbol.id.like("ez-%")).delete(synchronize_session=False)
+    db.query(EzFootprint).filter(EzFootprint.id.like("ez-%")).delete(synchronize_session=False)
+    db.commit()
+    _clean(db)
+    db.close()
