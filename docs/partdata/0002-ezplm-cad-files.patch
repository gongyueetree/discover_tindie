 def _parts_by_norm(db, keys: list[str]) -> dict[str, list]:
     out = defaultdict(list)
     for i in range(0, len(keys), 500):
@@ -377,6 +390,47 @@ async def part_detail(part_id: str, ctx: dict = Depends(partner)):
                                            "distributor": "Digi-Key / Mouser 查到、型号与厂商都对上的参数"})
 
 
+CAD_KINDS = {"symbol": ("application/x-kicad-symbol", "kicad_sym"), "footprint": ("application/x-kicad-footprint", "kicad_mod"),
+             "model": ("model/step", "step")}
+CAD_MAX_BYTES = 15 * 1024 * 1024
+
+
+@router.get("/parts/{part_id}/cad/{kind}")
+async def part_cad_file(part_id: str, kind: str, ctx: dict = Depends(partner)):
+    """物料关联的 ezPLM 自建库文件：symbol → .kicad_sym（自身 + 根符号），footprint → .kicad_mod，model → 封装的 .step。
+    只给 ezPLM 自建库里的（KiCad 官方库文件合作方自己取）；有未决冲突的字段不给；没有时 404。计入每天的物料详情数。"""
+    from fastapi.responses import Response
+    from . import previews
+    if kind not in CAD_KINDS:
+        _err("not_found", "kind 只能是 symbol / footprint / model", 404)
+    hdr = need(ctx, "parts:read")
+    db = ctx["db"]
+    ref = resolve(db, part_id, "part")
+    sp = db.get(StagedPart, ref) if ref else None
+    data = public_part(db, sp, full=True) if sp else None
+    if not data:
+        _err("not_found", "没有这个物料，或它没达到对外发布的质量要求", 404)
+    value = ((data.get("symbol" if kind == "symbol" else "footprint") or {}).get("value") or "").strip()
+    body, name = None, value.split(":")[-1].strip()
+    if value and kind == "symbol":
+        got = previews.ezplm_symbol_lib(value)
+        body = got[0].encode("utf-8") if got else None
+    elif value:
+        got = previews.ezplm_footprint_by_name(value)
+        path = got and got["mod" if kind == "footprint" else "step"]
+        if path and path.stat().st_size <= CAD_MAX_BYTES:
+            body = path.read_bytes()
+    if not body:
+        _err("not_found", "ezPLM 自建库里没有这个物料的文件", 404)
+    METER.detail(db, ctx["key"], ref)
+    db.commit()
+    media, ext = CAD_KINDS[kind]
+    safe = re.sub(r"[^\w.+-]", "_", name)[:80] or "part"
+    return Response(body, media_type=media, headers=hdr | {"Cache-Control": "private, max-age=86400",
+                                                           "Content-Disposition": f'attachment; filename="{safe}.{ext}"',
+                                                           "X-Content-Type-Options": "nosniff"})
+
+
 @router.post("/bom/match")
