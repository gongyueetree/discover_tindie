+++ b/ezplm_pilot/pub_api.py
@@ -311,9 +311,22 @@ def public_part(db, sp: StagedPart, full: bool = False) -> dict | None:
             "datasheet_url": _url(sp.new_datasheet), "has_datasheet_in_ezplm": bool(sp.orig_has_pdf),
             "product_url": _url(sp.orig_url) or _url(sp.new_url), "parameters": params,
             "used_in_designs": n_designs, "withheld": sorted(disputed & {"symbol", "footprint"}) or None}
+    out["ezplm_library"] = _ezplm_library(db, out["symbol"], out["footprint"])
     return out
 
 
+def _ezplm_library(db, symbol: dict | None, footprint: dict | None) -> dict | None:
+    """物料关联的符号 / 封装在 ezPLM 自建库里有没有文件（有就能用 /parts/{id}/cad/{kind} 下载）。"""
+    from .staging import EzFootprint, EzSymbol
+    sym = ((symbol or {}).get("value") or "").split(":")[-1].strip()
+    fp = ((footprint or {}).get("value") or "").split(":")[-1].strip()
+    s = db.execute(select(EzSymbol.id).where(EzSymbol.name == sym).limit(1)).first() if sym else None
+    f = db.execute(select(EzFootprint.has_3d).where(EzFootprint.name == fp).limit(1)).first() if fp else None
+    if not s and not f:
+        return None
+    return {"symbol": bool(s), "footprint": bool(f), "model": bool(f and f[0])}
+
