+def ezplm_symbol_preview(name: str, fetch: bool = True) -> dict | None:
+    """ezPLM 符号：下载自身和根符号文件，拼起来渲染。"""
+    got = ezplm_symbol_lib(name, fetch)
+    if not got:
+        return None
+    pv = symrender.preview(got[0], (name or "").split(":")[-1].strip())
     if pv:
-        pv["source"] = f"ezPLM 符号库（{row.category or ''}）"
+        pv["source"] = f"ezPLM 符号库（{got[1]}）"
     return pv
 
 
+def ezplm_footprint_by_name(name: str, fetch: bool = True) -> dict | None:
+    """ezPLM 自建封装 → {"id", "category", "mod": Path|None, "step": Path|None}；没有这个封装时 None。"""
+    from sqlalchemy import select
+    from .staging import EzFootprint, get_session
+    nm = (name or "").split(":")[-1].strip()
+    if not nm:
+        return None
+    db = get_session()
+    try:
+        row = db.execute(select(EzFootprint).where(EzFootprint.name == nm).limit(1)).scalars().first()
+    finally:
+        db.close()
+    if not row:
+        return None
+    return {"id": row.id, "category": row.category or "", **ezplm_footprint_files(row.id, fetch)}
+
