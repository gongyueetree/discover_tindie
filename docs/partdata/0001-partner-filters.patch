     db.commit()
     return reply({"query": {"mpn": mpn, "manufacturer": manufacturer or None}, "match": "exact" if items else "none", "items": items}, hdr)
 
 
 @router.get("/parts/search")
-async def parts_search(q: str, limit: int = 10, offset: int = 0, ctx: dict = Depends(partner)):
-    """型号前缀搜索；每页 ≤20，最多翻到第 100 条（不提供全量遍历）。"""
+async def parts_search(q: str, limit: int = 10, offset: int = 0, with_footprint: bool = False, ctx: dict = Depends(partner)):
+    """型号前缀搜索；每页 ≤20，最多翻到第 100 条（不提供全量遍历）。with_footprint=1 只要有封装（且封装无未决冲突）的物料。"""
     hdr = need(ctx, "parts:read")
     db = ctx["db"]
     k = norm_mpn(q)
     if len(k) < SEARCH["min_chars"]:
         _err("query_too_short", f"至少 {SEARCH['min_chars']} 个字符", 400)
     limit, offset = max(1, min(limit, SEARCH["max_limit"])), max(0, min(offset, SEARCH["max_offset"]))
-    rows = db.execute(select(StagedPart).where(StagedPart.mpn_norm.like(f"{k}%"), *gate_where())
+    where = [StagedPart.mpn_norm.like(f"{k}%"), *gate_where()]
+    if with_footprint:
+        where.append(or_(and_(StagedPart.orig_footprint.isnot(None), StagedPart.orig_footprint != ""),
+                         and_(StagedPart.new_footprint.isnot(None), StagedPart.new_footprint != "")))
+    rows = db.execute(select(StagedPart).where(*where)
                       .order_by(StagedPart.value_score.desc().nullslast(), StagedPart.mpn_norm).offset(offset).limit(limit + 1)).scalars().all()
-    items = [x for x in (public_part(db, p) for p in rows[:limit]) if x]
+    items = _list_items(db, rows[:limit], with_footprint)
     db.commit()
     return reply({"items": items}, hdr, pagination={"limit": limit, "offset": offset, "has_more": len(rows) > limit and offset + limit < SEARCH["max_offset"] + SEARCH["max_limit"]})
 
@@ -435,8 +468,10 @@ def _design_rows(db, bids: list[str]) -> list[dict]:
 
 
 @router.get("/designs")
-async def designs(part: str = "", mpn: str = "", family: str = "", limit: int = 10, offset: int = 0, ctx: dict = Depends(partner)):
-    """用到某个物料（part=对外 ID）/ 型号（mpn）/ 器件族（family）的参考设计。必须给其中一个。"""
+async def designs(part: str = "", mpn: str = "", family: str = "", function: str = "", min_stars: int = 0, eda: str = "",
+                  limit: int = 10, offset: int = 0, ctx: dict = Depends(partner)):
+    """用到某个物料（part=对外 ID）/ 型号（mpn）/ 器件族（family）/ 含某电路模块（function=模块 id，含子类）的参考设计。必须给其中一个。
+    可选过滤（在分页之前做）：min_stars 最少 GitHub 星数（厂商设计没有星数，min_stars≥1 时不出）；eda 工具，逗号分隔（如 kicad,eagle）。"""
     hdr = need(ctx, "designs:read")
     db = ctx["db"]
     limit, offset = max(1, min(limit, SEARCH["max_limit"])), max(0, min(offset, SEARCH["max_offset"]))
@@ -450,9 +485,23 @@ async def designs(part: str = "", mpn: str = "", family: str = "", limit: int =
         snap = kg.current(db)
         f = family.removeprefix("fam:")
         bids = [d["design_id"] for d in kg.designs_of(db, snap, f, limit=500)[0]] if snap else []
+    elif function:
+        from .staging import ModuleCategory, OshwBomModule
+        f = function.strip()
+        ids = {f} | {m for (m,) in db.execute(select(ModuleCategory.id).where(ModuleCategory.id.like(f + ".%")))}
+        q = (select(OshwBom.bom_id).join(OshwBomModule, OshwBomModule.bom_id == OshwBom.bom_id)
+             .where(OshwBomModule.module_id.in_(ids), *design_where()))
+        if min_stars > 0:
+            q = q.where(OshwBom.stars >= min_stars)
+        bids = list(dict.fromkeys(b for (b,) in db.execute(q.order_by(OshwBom.stars.desc().nullslast()).limit(4000))))
     else:
-        _err("bad_request", "要给 part、mpn 或 family 其中一个（型号至少 3 个字符）", 400)
+        _err("bad_request", "要给 part、mpn、family 或 function 其中一个（型号至少 3 个字符）", 400)
     rows = _design_rows(db, bids[:2000])
+    if min_stars > 0:
+        rows = [r for r in rows if (r["stars"] or 0) >= min_stars]
+    tools = {t.strip().lower() for t in eda.split(",") if t.strip()}
+    if tools:
+        rows = [r for r in rows if (r["eda_tool"] or "").lower() in tools]
     db.commit()
     return reply({"items": rows[offset:offset + limit]}, hdr, pagination={"limit": limit, "offset": offset, "total": min(len(rows), SEARCH["max_offset"] + SEARCH["max_limit"])})
 
