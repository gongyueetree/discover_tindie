+def _disputed(db, part_ids: list[str]) -> dict[str, set]:
+    """有未决冲突（flag_mismatch 待复核）的字段：这些字段不对外。"""
+    out: dict[str, set] = defaultdict(set)
+    for i in range(0, len(part_ids), 500):
+        for pid, f in db.execute(select(StagedProposal.part_id, StagedProposal.field).where(
+                StagedProposal.part_id.in_(part_ids[i:i + 500]), StagedProposal.action == "flag_mismatch", StagedProposal.review_status == "pending")):
+            out[pid].add(f)
+    return out
+
+
+def _summary_footprint(sp: StagedPart, disputed: set) -> str | None:
+    """列表里的封装名（只给名字；有冲突时不给）。合作方据此判断能否放进 PCB 规划器。"""
+    return None if "footprint" in disputed else (sp.orig_footprint or sp.new_footprint or None)
+
+
+def _list_items(db, parts: list, with_footprint: bool = False) -> list[dict]:
+    disputed = _disputed(db, [p.id for p in parts])
+    out = []
+    for p in parts:
+        x = public_part(db, p)
+        if not x:
+            continue
+        x["footprint"] = _summary_footprint(p, disputed.get(p.id, set()))
+        if with_footprint and not x["footprint"]:
+            continue
+        out.append(x)
+    return out
+
