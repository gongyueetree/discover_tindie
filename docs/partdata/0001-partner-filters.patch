+def test_partner_filters_function_stars_eda_footprint(client):
+    """Tindie: designs by circuit module (incl. sub-modules), min_stars / eda filters before paging; footprint in list items."""
+    from ezplm_pilot.staging import ModuleCategory, OshwBomModule
+    from ezplm_pilot.web import _new_session
+    db = _new_session()
+    _seed(db)
+    db.merge(ModuleCategory(id="pfx", name="电源", depth=0))
+    db.merge(ModuleCategory(id="pfx.ldo", parent="pfx", name="LDO", depth=1))
+    db.add(OshwBom(bom_id="pd-4", project_id="pd-4", project_name="Zero-star board", gh_repo="acme/zero", commit_="def5678", license="MIT",
+                   group_lead=True, parse_status="succeeded", stars=0, eda_tool="kicad"))
+    db.add(RepoStat(repo="acme/zero", stars=0, license="MIT"))
+    for i in range(6):
+        db.add(OshwItem(item_id=f"pd-4-{i}", bom_id="pd-4", value=f"PUBV{i}", key_norm=f"PUBV{i}0", designators=f"U{i}", quantity=1))
+    db.query(OshwBom).filter(OshwBom.bom_id == "pd-1").update({"eda_tool": "kicad"})
+    db.add_all([OshwBomModule(bom_id="pd-1", module_id="pfx.ldo", n_items=1), OshwBomModule(bom_id="pd-4", module_id="pfx", n_items=1),
+                OshwBomModule(bom_id="pd-3", module_id="pfx", n_items=1)])
+    db.commit()
+    pub_api.METER.reset()
+    kid, sec = pub_api.new_key(db, "tindie", list(pub_api.SCOPES))
+    names = lambda r: [x["name"] for x in r.json()["data"]["items"]]
+    r = call(client, kid, sec, "GET", "/api/pub/v1/designs", {"function": "pfx"})
+    assert set(names(r)) == {"RS485 board", "Zero-star board", "TI design"}            # 子类 pfx.ldo 的设计也算
+    r = call(client, kid, sec, "GET", "/api/pub/v1/designs", {"function": "pfx", "min_stars": "1"})
+    assert names(r) == ["RS485 board"] and r.json()["meta"]["pagination"]["total"] == 1   # 0 星、厂商设计（无星数）不出
+    r = call(client, kid, sec, "GET", "/api/pub/v1/designs", {"function": "pfx", "eda": "kicad,eagle"})
+    assert set(names(r)) == {"RS485 board", "Zero-star board"}
+    assert call(client, kid, sec, "GET", "/api/pub/v1/designs", {}).status_code == 400
+    s = call(client, kid, sec, "GET", "/api/pub/v1/parts/search", {"q": "PUBX485"}).json()["data"]["items"]
+    by = {x["mpn"]: x for x in s}
+    assert by["PUBX485ECSA+"]["footprint"] is None                                      # 封装有未决冲突：列表里也不给
+    s = call(client, kid, sec, "GET", "/api/pub/v1/parts/search", {"q": "PUBX485", "with_footprint": "1"}).json()["data"]["items"]
+    assert s == []
+    db.query(OshwBomModule).filter(OshwBomModule.bom_id.in_(["pd-1", "pd-3", "pd-4"])).delete(synchronize_session=False)
+    db.query(ModuleCategory).filter(ModuleCategory.id.like("pfx%")).delete(synchronize_session=False)
+    db.commit()
+    _clean(db)
+    db.close()
