     """按完整型号精确查（规范化后相同）；给了厂商就只留同一家。"""
     hdr = need(ctx, "parts:read")
     db = ctx["db"]
@@ -308,23 +337,27 @@ async def parts_lookup(mpn: str, manufacturer: str = "", ctx: dict = Depends(par
         from .ihs import Lineage
         lin = Lineage(db=db)
         hits = [p for p in hits if same_maker(p.manufacturer, manufacturer, lin)]
