+@router.get("/designs/{design_id}/board.svg")
+async def design_board_svg(design_id: str, ctx: dict = Depends(partner)):
+    """设计的 PCB 预览图（SVG，由工程里的 PCB 生成：板框、铜、焊盘；不含丝印文字）。没有时 404。"""
+    import gzip
+    from fastapi.responses import Response
+    from .staging import OshwCover
+    hdr = need(ctx, "designs:read")
+    db = ctx["db"]
+    ref = resolve(db, design_id, "design")
+    b = db.execute(select(OshwBom).where(OshwBom.bom_id == ref, *design_where())).scalars().first() if ref else None
+    c = db.get(OshwCover, b.bom_id) if b and _kind(b) == "open_source" else None
+    if not c or not c.svg_gz:
+        _err("not_found", "这个设计没有 PCB 预览图", 404)
+    db.commit()
+    return Response(gzip.decompress(c.svg_gz), media_type="image/svg+xml",
+                    headers=hdr | {"Cache-Control": "private, max-age=86400", "Content-Security-Policy": "default-src 'none'; style-src 'unsafe-inline'"})
+
